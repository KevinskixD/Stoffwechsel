rules_version = '2';

// No authentication exists in this app (single local user, no Firebase Hosting deploy).
// These rules are NOT a real access boundary - anyone with the Firebase project config
// could read/write these four collections. They only prevent writes to unrelated
// collection paths if the config ever leaks. Revisit (add auth) if hosting plans change
// or the config is ever exposed publicly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /employees/{id} {
      allow read, write: if true;
    }
    match /articles/{id} {
      allow read, write: if true;
    }
    match /orderStatuses/{id} {
      allow read, write: if true;
    }
    match /orders/{id} {
      allow read, write: if true;
    }
    match /orderHistory/{id} {
      allow read, write: if true;
    }
    match /pickupLocations/{id} {
      allow read, write: if true;
    }
    match /starterKitCategories/{id} {
      allow read, write: if true;
    }
    match /notificationSettings/{id} {
      allow read, write: if true;
    }
    match /bestellFormularSettings/{id} {
      allow read, write: if true;
    }
    match /orderListSettings/{id} {
      allow read, write: if true;
    }
    match /lieferscheinChecks/{id} {
      allow read, write: if true;
    }
    match /appMeta/{id} {
      allow read, write: if true;
    }
  }
}
